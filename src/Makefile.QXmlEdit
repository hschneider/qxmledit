####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/qxmledit || mkdir -p $(INSTALL_ROOT)/opt/qxmledit
	$(DEL_FILE) -r $(INSTALL_ROOT)/opt/qxmledit/QXmlEdit.app
	
	$(QINSTALL) ../build/QXmlEdit.app $(INSTALL_ROOT)/opt/qxmledit/QXmlEdit.app
	-$(STRIP) $(INSTALL_ROOT)/opt/qxmledit/QXmlEdit.app/Contents/MacOS/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/opt/qxmledit/QXmlEdit.app
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/qxmledit/ 


install_translationsfiles: first FORCE
	@test -d $(INSTALL_ROOT)/opt/qxmledit/translations || mkdir -p $(INSTALL_ROOT)/opt/qxmledit/translations
	$(QINSTALL) /Users/hschneider/Work/Software/Playground/qxmledit/src/languages_app/QXmlEdit_cs.qm $(INSTALL_ROOT)/opt/qxmledit/translations/QXmlEdit_cs.qm
	$(QINSTALL) /Users/hschneider/Work/Software/Playground/qxmledit/src/languages_app/QXmlEdit_ru.qm $(INSTALL_ROOT)/opt/qxmledit/translations/QXmlEdit_ru.qm

uninstall_translationsfiles: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/opt/qxmledit/translations/QXmlEdit_ru.qm
	-$(DEL_FILE) -r $(INSTALL_ROOT)/opt/qxmledit/translations/QXmlEdit_cs.qm
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/qxmledit/translations/ 


