	-$(DEL_FILE) ../build/app/obj/QXmlEdit_arm64.pch/c_arm64.pch ../build/app/obj/QXmlEdit_arm64.pch/c++_arm64.pch ../build/app/obj/QXmlEdit_arm64.pch/objective-c_arm64.pch ../build/app/obj/QXmlEdit_arm64.pch/objective-c++_arm64.pch
