risorse.qrc:
/opt/homebrew/lib/QtPrintSupport.framework/Resources/QtPrintSupport.prl:
/opt/homebrew/lib/QtWidgets.framework/Resources/QtWidgets.prl:
/opt/homebrew/lib/QtSvg.framework/Resources/QtSvg.prl:
